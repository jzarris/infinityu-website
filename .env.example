# Site URL (used for SEO canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL=https://www.infinity-u.com

# Resend API key for contact form and newsletter emails
RESEND_API_KEY=

# Contact form recipient email
CONTACT_EMAIL=services@infinity-u.com

# External booking URL (Jane, Vagaro, or Mindbody)
NEXT_PUBLIC_BOOKING_URL=

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/infinityu?schema=public

# NextAuth secret (generate with: openssl rand -base64 64)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
