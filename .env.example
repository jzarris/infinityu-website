# Site URL (used for SEO canonical URLs and OG images)
NEXT_PUBLIC_SITE_URL=https://www.infinity-u.com

# Company name shown in the intake acknowledgment text (set in Railway)
NEXT_PUBLIC_COMPANY_NAME=InfinityU

# Resend API key for contact form and newsletter emails
RESEND_API_KEY=

# Contact form recipient email
CONTACT_EMAIL=services@infinity-u.com

# External booking URL (Jane, Vagaro, or Mindbody)
NEXT_PUBLIC_BOOKING_URL=

# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/infinityu?schema=public

# NextAuth secret (generate with: openssl rand -base64 64)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# AestheticIQ CRM integration — intake submissions are forwarded to the CRM
# AESTHETICIQ_WEBHOOK_URL: full URL to the AestheticIQ intake endpoint (e.g. https://api.aestheticiq.com/api/v1/intake)
# AESTHETICIQ_API_TOKEN: API token (JWT) generated in AestheticIQ admin with clients:write permission
AESTHETICIQ_WEBHOOK_URL=
AESTHETICIQ_API_TOKEN=
